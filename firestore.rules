rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function isClient() {
      return request.auth != null && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client')
      );
    }
    function isProvider() {
      return request.auth != null && (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'provider');
    }

    match /admins/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }
    
    match /providers/{providerId} {
      // Clients and admins can read providers. Providers can read their own.
      allow read: if request.auth != null;
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == providerId);
      allow update: if isAdmin() || 
         (request.auth != null && request.auth.uid == providerId && 
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'applicationStatus']) || 
            (request.resource.data.get('applicationStatus', '') != 'approved' && request.resource.data.get('verified', false) != true))
        ) || 
         // Allow clients to update isBusy and currentBookingId when creating a booking
         (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBusy', 'currentBookingId']));
      allow delete: if isAdmin();
    }
    
    match /providerApplications/{providerId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == providerId);
      allow update: if isAdmin() || 
         (request.auth != null && request.auth.uid == providerId && 
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['applicationStatus']) || 
            request.resource.data.get('applicationStatus', '') != 'approved')
        );
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == providerId);
      allow delete: if isAdmin();
    }
    
    match /bookings/{bookingId} {
      allow create: if request.auth != null && request.resource.data.patientId == request.auth.uid;
      // Clients can read their bookings. Providers can read bookings assigned to them.
      allow read: if (request.auth != null && resource.data.patientId == request.auth.uid) || (request.auth != null && resource.data.providerId == request.auth.uid) || isAdmin();
      allow update: if (request.auth != null && resource.data.patientId == request.auth.uid) || (request.auth != null && resource.data.providerId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /services/{document=**} { allow read, write: if true; }
    
    match /serviceCategories/{document=**} { allow read, write: if true; }
    
    match /pharmacyProducts/{productId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    
    match /physician_bookings/{bookingId} {
      allow create: if request.auth != null && request.resource.data.clientId == request.auth.uid && request.resource.data.amount == 15000;
      allow read: if (request.auth != null && resource.data.clientId == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /pharmacyOrders/{orderId} {
      allow create: if request.auth != null && request.resource.data.clientId == request.auth.uid;
      allow read: if (request.auth != null && resource.data.clientId == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /pharmacyCategories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
    match /menstrualCycles/{cycleId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
